<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>TeacherFinder.Core.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\TeacherFinder.Core\TeacherFinder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Os testes de "dados reais" leem o mesmo professores.json da raiz. -->
    <Content Include="..\..\..\professores.json" Link="Data\professores.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
